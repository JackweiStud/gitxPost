# gitxPost local LLM configuration
# Copy this file to .env and fill in real values.

XPOST_LLM_API_KEY=your_tokenmax_api_key
XPOST_LLM_API_URL=https://tokenmax.vip/v1/messages
XPOST_LLM_MODEL=claude-opus-4-6
XPOST_RADAR_LLM_MODEL=claude-opus-4-6

# 主 LLM 失败时自动切换（OpenAI 兼容 Chat Completions，例如本地 Antigravity）
# URL 可写完整 …/v1/chat/completions，或只写 …/v1（将自动补全 chat/completions）
# XPOST_LLM_FALLBACK_API_URL=http://127.0.0.1:8045/v1
# XPOST_LLM_FALLBACK_API_KEY=sk-your-key
# XPOST_LLM_FALLBACK_MODEL=gemini-3-flash
# 走备用链路时请求里的 max_tokens 不会超过此值（默认 8192，适配 Gemini 等）
# XPOST_LLM_FALLBACK_MAX_TOKENS=8192
# 可选：备份端协议，默认 openai；若备份其实是 Anthropic Messages 再设为 anthropic
# XPOST_LLM_FALLBACK_API_KIND=openai
# 周报/日报在走备份时可用不同模型（不设置则用 XPOST_LLM_FALLBACK_MODEL）
# XPOST_RADAR_LLM_FALLBACK_MODEL=

# 图像生成配置（文章自动配图）
# 默认会复用上面的备用网关地址和密钥；若你想单独切换，也可以单独覆盖
# XPOST_IMAGE_API_URL=http://127.0.0.1:8045/v1
# XPOST_IMAGE_API_KEY=sk-your-key
# XPOST_IMAGE_MODEL=gemini-3.1-flash-image
